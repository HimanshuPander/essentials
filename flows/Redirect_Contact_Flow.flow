    <screens>
        <name>Redirect_to_Contact</name>
        <label>Redirect to Contact</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>redirectContact</name>
            <fieldText>&lt;p&gt;&lt;a href=&quot;/{!contactId}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;strong&gt;Click here to redirect to the newly created Contact.&lt;/strong&gt;&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
