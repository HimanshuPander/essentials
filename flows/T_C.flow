<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_T_C</name>
        <label>Check T&amp;C</label>
        <locationX>380</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isNotAccepted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.T_C_Accepted__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Terms_Conditions</targetReference>
            </connector>
            <label>isNotAccepted?</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Accepted_T_C</name>
        <label>User Accepted T &amp; C</label>
        <locationX>182</locationX>
        <locationY>398</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Accepted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>I_Agree</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_User_Record</targetReference>
            </connector>
            <label>Accepted?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>T&amp;C {!$Flow.CurrentDateTime}</interviewLabel>
    <label>T&amp;C</label>
    <processMetadataValues>
