    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Delivery_Schedule_14_Days_Or_Less</fullName>
        <active>true</active>
        <description>Sets end date for initial delivery</description>
        <errorConditionFormula>ISPICKVAL( StageName , &quot;Closed Won&quot;) &amp;&amp;  (  Delivery_Schedule_Date__c  -  CloseDate  )  &gt; 14</errorConditionFormula>
        <errorDisplayField>Delivery_Schedule_Date__c</errorDisplayField>
        <errorMessage>Dates of type delivery must be no later than 14 days after close date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Owner_owner_read_only</fullName>
        <active>true</active>
        <errorConditionFormula>AND( $Profile.Name  &lt;&gt;  &apos;System Administrator&apos;, ISCHANGED(  OwnerId  ))</errorConditionFormula>
        <errorDisplayField>OwnerId</errorDisplayField>
        <errorMessage>Owner can&apos;t be changed!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_updatiion_of_Account_phone</fullName>
        <active>true</active>
        <description>Restrict the updation of Account Phone field</description>
        <errorConditionFormula>AND( NOT( ISBLANK( AccountId ) ) ,
      ISCHANGED( Account_Phone__c ) ,
      NOT( Bypass_Validation_Rule_for_Process_Build__c )
 )</errorConditionFormula>
        <errorDisplayField>Account_Phone__c</errorDisplayField>
        <errorMessage>Account Phone cannot be changed !</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Create_Action_Plan</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Create Action Plan</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/apex/ActionPlanCreation?refType=Opportunity&amp;refId={!Opportunity.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Create_Action_Plans</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Create Opportunity Action Plans</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>var records = {!GETRECORDIDS( $ObjectType.Opportunity )} ;
var oName = &apos;Opportunity&apos;;
var error = false;
var msj = &apos;&apos;;

if( records.length &gt; 40 ) { 
    error = true; 
    msj =&apos;{!$Label.ap_Errors_moreThan20records}&apos;;
}
if( records.length &lt; 1 ){
   error = true;
   msj = &apos;{!$Label.ap_Errors_selectOneRecord}&apos;; 
}

if( error ) {
       alert(msj);    
}
else{
       location.href = &apos;/apex/ActionPlanCreation?refId=&apos;+records+&apos;&amp;refType=&apos;+oName;
}</url>
    </webLinks>
    <webLinks>
        <fullName>DeliveryStatus</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>true</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>true</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Delivery Status</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>true</showsLocation>
        <showsStatus>true</showsStatus>
        <url>http://www.fedex.com/cgi-bin/tracking?tracknumbers={!Opportunity_Tracking_Number}&amp;action=track&amp;language=english&amp;cntry_code=us</url>
    </webLinks>
</CustomObject>