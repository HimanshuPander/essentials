    <fields>
        <fullName>Bus_Plate_Number__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Refers to the Vehicle Registration Number of Bus.</description>
        <externalId>false</externalId>
        <inlineHelpText>Vehicle Registration Number</inlineHelpText>
        <label>Bus Plate Number</label>
        <length>10</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Bus_Type__c</fullName>
        <description>Bus Type field has two values, Aircon and Non Aircon</description>
        <label>Bus Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>A.C.</fullName>
                    <default>true</default>
                    <label>A.C.</label>
                </value>
                <value>
                    <fullName>Non A.C.</fullName>
                    <default>false</default>
                    <label>Non A.C.</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Capacity__c</fullName>
        <description>Total number of persons a bus can accomodate including driver.</description>
        <externalId>false</externalId>
        <inlineHelpText>Total Number of Persons a bus can accomodate.</inlineHelpText>
        <label>Capacity</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Bus</label>
    <nameField>
        <displayFormat>A - {0000}</displayFormat>
        <label>Bus Id</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Busses</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
