    <webLinks>
        <fullName>Billing</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>true</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>true</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Billing</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>true</showsLocation>
        <showsStatus>true</showsStatus>
        <url>http://www.genwatt.com/genwatt/billing.htm?actname={!Account_Name}</url>
    </webLinks>
    <webLinks>
        <fullName>Create_Action_Plan</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Create Action Plan</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/apex/ActionPlanCreation?refType=Account&amp;refId={!Account.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Create_Action_Plans</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Create Account Action Plans</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>var records = {!GETRECORDIDS( $ObjectType.Account )} ;
var oName = &apos;Account&apos;;
var error = false;
var msj = &apos;&apos;;

if( records.length &gt; 40 ) { 
    error = true; 
    msj =&apos;{!$Label.ap_Errors_moreThan20records}&apos;;
}
if( records.length &lt; 1 ){
   error = true;
   msj = &apos;{!$Label.ap_Errors_selectOneRecord}&apos;; 
}

if( error ) {
       alert(msj);    
}
else{
       location.href = &apos;/apex/ActionPlanCreation?refId=&apos;+records+&apos;&amp;refType=&apos;+oName;
}</url>
    </webLinks>
    <webLinks>
        <fullName>Map_Location</fullName>
