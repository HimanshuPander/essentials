<?xml version="1.0" encoding="UTF-8"?>
<CustomApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <brand>
        <headerColor>#0D3B66</headerColor>
        <logo>X3removebgpreview</logo>
        <logoVersion>1</logoVersion>
        <shouldOverrideOrgTheme>true</shouldOverrideOrgTheme>
    </brand>
    <description>SFDC Insights is our internal app designed to streamline access to our blog content. Stay updated with the latest Salesforce Platform Basics, insightful articles, and informative posts. Dive deep into Salesforce setup, navigation, and best practices right</description>
    <formFactors>Small</formFactors>
    <formFactors>Large</formFactors>
    <isNavAutoTempTabsDisabled>false</isNavAutoTempTabsDisabled>
    <isNavPersonalizationDisabled>false</isNavPersonalizationDisabled>
    <isNavTabPersistenceDisabled>false</isNavTabPersistenceDisabled>
    <isOmniPinnedViewEnabled>false</isOmniPinnedViewEnabled>
    <label>SFDC Insights</label>
    <navType>Standard</navType>
    <tabs>standard-home</tabs>
    <tabs>standard-Campaign</tabs>
    <tabs>standard-Lead</tabs>
    <tabs>standard-Account</tabs>
    <tabs>standard-Contact</tabs>
    <tabs>standard-Opportunity</tabs>
    <tabs>Project__c</tabs>
    <tabs>Employee__c</tabs>
    <uiType>Lightning</uiType>
    <utilityBar>SFDC_Insights_UtilityBar</utilityBar>
</CustomApplication>
