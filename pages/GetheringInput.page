<apex:page standardController="Account" showHeader="true" sidebar="true">
    <apex:form >
        <apex:pageBlock title="Edit Account : {!Account.Name}">
            <apex:pageBlockSection title="Account Details" columns="1">                                                                                                                            
                <apex:inputText value="{!Account.Name}" tabindex="4" required="true"/>
                <apex:inputText value="{!Account.Website}" tabindex="3"/>
                <apex:inputText value="{!Account.Industry}" tabindex="2"/>
                <apex:inputText value="{!Account.AnnualRevenue}" tabindex="1"/>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>